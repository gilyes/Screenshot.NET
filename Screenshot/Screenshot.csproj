<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>GI.Screenshot</RootNamespace>
    <AssemblyName>GI.Screenshot</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- NuGet Package Metadata -->
    <PackageId>GI.Screenshot</PackageId>
    <Version>1.1.0</Version>
    <Title>GI.Screenshot</Title>
    <Authors>George Ilyes</Authors>
    <Company>George Ilyes</Company>
    <Product>GI.Screenshot</Product>
    <Description>Simple screenshot capture library for the .NET Framework.</Description>
    <Copyright>Copyright (c) 2019</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gilyes/Screenshot.NET</PackageProjectUrl>
    <PackageTags>screenshot, screen-capture</PackageTags>
    <PackageReleaseNotes>Fixed preview when dragging mouse up/left.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Cross.cur" />
  </ItemGroup>

</Project>
