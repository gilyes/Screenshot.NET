<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net6.0-windows;net8.0-windows</TargetFrameworks>
    <RootNamespace>GI.Screenshot</RootNamespace>
    <AssemblyName>GI.Screenshot</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Metadata -->
    <PackageId>GI.Screenshot</PackageId>
    <Version>1.2.0</Version>
    <Title>GI.Screenshot</Title>
    <Authors>George Ilyes</Authors>
    <Company>George Ilyes</Company>
    <Product>GI.Screenshot</Product>
    <Description>Simple screenshot capture library for .NET/.NET Framework.</Description>
    <Copyright>Copyright (c) 2019</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gilyes/Screenshot.NET</PackageProjectUrl>
    <PackageTags>screenshot, screen-capture</PackageTags>
    <PackageReleaseNotes>Multitargeting .NET Framework and .NET</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Cross.cur" />
  </ItemGroup>

</Project>
